{
    "dataset_path": [
        "data/datasets/obesity_risk/train/train.csv",
        "data/datasets/obesity_risk/test/test.csv"
    ],
    "is_split": true,
    "base_models": [
        "rf",
        "svm",
        "nb",
        "lr",
        "et"
    ],
    "num_base_models_in_each_ensemble": 3,
    "num_ensembles": 2,
    "feature_names": [
        "feature1",
        "feature2",
        "feature3",
        "feature4"
    ],
    "target_col": "NObeyesdad",
    "split_ratio": 0.2,
    "results_folder": "data/monolithic/results/obesity_risk",
    "use_feature_range": true,
    "feature_range": [
        "id",
        "MTRANS"
    ],
    "feature_mapping_path": "data/monolithic/configurations/obesity_risk/feature_mapping.csv",
    "model_params": {
        "rf": {
            "n_estimators": 100,
            "max_depth": 15,
            "min_samples_split": 4,
            "random_state": 42
        },
        "et": {
            "n_estimators": 100,
            "max_depth": 15,
            "min_samples_split": 4,
            "random_state": 42
        },
        "svm": {
            "C": 1.0,
            "kernel": "rbf",
            "gamma": "scale",
            "probability": true,
            "random_state": 42
        },
        "lr": {
            "solver": "liblinear",
            "C": 0.7,
            "max_iter": 200
        }
    }
}
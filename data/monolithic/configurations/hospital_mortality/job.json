{
    "dataset_path": "data/datasets/hospital_mortality/mimic3c.csv",
    "is_split": false,
    "base_models": [
        "rf",
        "nb",
        "lr",
        "et",
        "gb"
    ],
    "num_base_models_in_each_ensemble": 3,
    "num_ensembles": 2,
    "feature_names": [
        "hadm_id",
        "gender",
        "age",
        "LOSdays",
        "admit_type",
        "admit_location",
        "AdmitDiagnosis",
        "insurance",
        "religion",
        "marital_status",
        "ethnicity",
        "NumCallouts",
        "NumDiagnosis",
        "NumProcs",
        "AdmitProcedure",
        "NumCPTevents",
        "NumInput",
        "NumLabs",
        "NumMicroLabs",
        "NumNotes",
        "NumOutput",
        "NumRx",
        "NumProcEvents",
        "NumTransfers",
        "NumChartEvents",
        "ExpiredHospital",
        "TotalNumInteract",
        "LOSgroupNum"
    ],
    "target_col": "ExpiredHospital",
    "split_ratio": 0.2,
    "results_folder": "data/monolithic/results/hospital_mortality",
    "use_feature_range": false,
    "feature_range": [
        "hadm_id",
        "LOSgroupNum"
    ],
    "feature_mapping_path": "data/monolithic/configurations/hospital_mortality/feature_mapping.csv",
    "pretrained_ensemble_path": "data/monolithic/pretrained_ensembles/hospital_mortality",
    "ignore_pretrained": false,
    "large_dataset_threshold": 50000,
    "sampling_ratio": 0.2,
    "model_params": {
        "rf": {
            "n_estimators": 150,
            "max_depth": 20,
            "min_samples_split": 4,
            "random_state": 42
        },
        "nb": {},
        "lr": {
            "solver": "liblinear",
            "C": 1.0,
            "max_iter": 200
        },
        "et": {
            "n_estimators": 120,
            "max_depth": 15,
            "min_samples_split": 4,
            "random_state": 42
        },
        "gb": {
            "n_estimators": 100,
            "learning_rate": 0.1,
            "max_depth": 10,
            "random_state": 42
        }
    }
}
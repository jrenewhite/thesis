{
    "dataset_path": "data/datasets/digits/train.csv",
    "is_split": false,
    "base_models": [
        "rf",
        "svm",
        "et",
        "dt"
    ],
    "num_base_models_in_each_ensemble": 3,
    "num_ensembles": 2,
    "feature_names": [],
    "target_col": "label",
    "split_ratio": 0.2,
    "results_folder": "data/monolithic/results/digits",
    "use_feature_range": true,
    "feature_range": [
        "pixel0",
        "pixel783"
    ],
    "feature_mapping_path": "data/monolithic/configurations/digits/feature_mapping.csv",
    "pretrained_ensemble_path": "data/monolithic/pretrained_ensembles/digits",
    "ignore_pretrained": false,
    "model_params": {
        "rf": {
            "n_estimators": 100,
            "max_depth": 12,
            "min_samples_split": 3,
            "random_state": 42
        },
        "svm": {
            "C": 1.0,
            "kernel": "rbf",
            "gamma": "scale",
            "probability": true,
            "random_state": 42
        },
        "et": {
            "n_estimators": 120,
            "max_depth": 12,
            "min_samples_split": 4,
            "random_state": 42
        },
        "dt": {
            "max_depth": 10,
            "min_samples_split": 4,
            "random_state": 42
        }
    }
}